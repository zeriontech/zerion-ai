# Copy this file to .env.local and fill in the values.
# `NEXT_PUBLIC_*` vars are exposed to the browser. Everything else is
# server-only.

# Solana cluster the app runs against. mainnet-beta or devnet.
NEXT_PUBLIC_NETWORK=__NETWORK__

# Paid / private Solana RPC endpoint. Free public RPCs WILL rate-limit
# under any real load and cause silent scan stalls. Use Helius / Triton /
# QuickNode / Alchemy.
NEXT_PUBLIC_RPC_URL=__DEFAULT_RPC__

# WebSocket RPC endpoint. Many providers ship a separate WS URL.
NEXT_PUBLIC_RPC_WS_URL=

# Default token mint the app supports out of the box. Must be on the
# Umbra supported-tokens list. The user can swap later.
NEXT_PUBLIC_DEFAULT_MINT=__DEFAULT_MINT__

# UTXO indexer + relayer are called DIRECTLY from the browser (no proxy).
# These are public, CORS-enabled Umbra services.
NEXT_PUBLIC_INDEXER_URL=__DEFAULT_INDEXER__
NEXT_PUBLIC_RELAYER_URL=__DEFAULT_RELAYER__

# Data indexer is PROXIED — the browser hits its own origin via
# `/proxy/data-indexer` and the rewrite in next.config.ts forwards to
# the upstream below. Do NOT change this — it must stay as the proxy
# path.
NEXT_PUBLIC_DATA_INDEXER_URL=/proxy/data-indexer

# Server-only upstream URL for the data-indexer proxy. Read by
# next.config.ts at build / start time. NEVER exposed to the browser.
DATA_INDEXER_UPSTREAM=__DEFAULT_DATA_INDEXER__
